# Next.js public Supabase config.
# These values are safe to expose to the browser, but they still belong in env files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase project metadata for CLI/deployment scripts.
SUPABASE_PROJECT_REF=

# Server-side only. Never expose these in Next.js public env vars or React Native shell code.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

