# Next.js public Supabase config.
# These values are safe to expose to the browser, but they still belong in env files.
# Local Docker Supabase default URL: http://127.0.0.1:54321
# Copy the local publishable key from `npm run supabase:start` or `npm run supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase project metadata for CLI/deployment scripts.
SUPABASE_PROJECT_REF=

# Server-side only. Never expose these in PWA/browser bundles or a future React Native shell.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
